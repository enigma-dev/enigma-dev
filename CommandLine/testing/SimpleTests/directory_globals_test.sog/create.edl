directory_create(game_save_id);
gtest_assert_ne(game_save_id, "");
gtest_assert_true(set_working_directory(game_save_id));
gtest_assert_ne(working_directory, "");
gtest_assert_eq(working_directory, game_save_id);
gtest_assert_ne(program_pathname, "");
gtest_assert_ne(program_directory, "");
gtest_assert_ne(program_filename, "");
gtest_assert_ne(temp_directory, "");
gtest_assert_ne(directory_get_desktop_path(), "");
gtest_assert_ne(directory_get_documents_path(), "");
gtest_assert_ne(directory_get_downloads_path(), "");
gtest_assert_ne(directory_get_music_path(), "");
gtest_assert_ne(directory_get_pictures_path(), "");
gtest_assert_ne(directory_get_videos_path(), "");
directory_create(working_directory + "poop");
if (os_type == os_windows) {
  directory_create(working_directory + "poop\boob");
  gtest_assert_eq(filename_addslash(working_directory + "poop\boob"), working_directory + "poop\boob\");
} else {
  directory_create(working_directory + "poop/boob");
  gtest_assert_eq(filename_addslash(working_directory + "poop/boob"), working_directory + "poop/boob/");
}
game_end();
