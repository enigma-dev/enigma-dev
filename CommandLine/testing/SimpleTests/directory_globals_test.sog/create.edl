directory_create(game_save_id);
gtest_assert_ne(game_save_id, "");
gtest_assert_true(set_working_directory(game_save_id));
gtest_assert_ne(working_directory, "");
gtest_assert_eq(working_directory, game_save_id);
gtest_assert_ne(program_pathname, "");
gtest_assert_ne(program_directory, "");
gtest_assert_ne(program_filename, "");
gtest_assert_ne(desktop_directory, "");
gtest_assert_ne(documents_directory, "");
gtest_assert_ne(downloads_directory, "");
gtest_assert_ne(music_directory, "");
gtest_assert_ne(pictures_directory, "");
gtest_assert_ne(videos_directory, "");
gtest_assert_ne(public_directory, "");
gtest_assert_ne(temp_directory, "");
game_end();
